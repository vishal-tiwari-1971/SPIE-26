
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id          String   @id @default(uuid())
  title       String
  image       String?
  description String?
  date        DateTime
  venue       String
  status      Status   @default(UPCOMING)
  createdAt   DateTime @default(now())
  registrations Registration[]
   rules       EventRule[]
  leaderboard Leaderboard[]
  isGroupEvent  Boolean  @default(false)
  minTeamSize   Int?
  maxTeamSize   Int?
  teams         Team[]

}

model EventRule {
  id        String   @id @default(uuid())
  eventId   String
  section   RuleSection
  content   String   // markdown or plain text
  order     Int

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, section])
}

enum RuleSection {
  OVERVIEW
  ELIGIBILITY
  TEAM_COMPOSITION
  EVENT_FLOW
  JUDGING_CRITERIA
  DURATION 
  PRIZE
  PRECAUTION
  CONNECT
}


model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  registrationNumber String?

  googleId  String?  @unique
  password  String?  // only for admin

  role      Role     @default(USER)
  createdAt DateTime @default(now())
  registrations Registration[]
  teams     Team[]
}

model Registration {
  id        String   @id @default(uuid())
  userId    String
  eventId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId]) // ❗ prevents double registration
}

model Leaderboard {
  id        String   @id @default(uuid())
  eventId   String
  rank      Int
  name      String?
  registrationNumber String?
  score     Int?
  teamName  String? // for group events
  teamMembers TeamMemberInfo[] // for group events
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)


}

model TeamMemberInfo {
  id                 String   @id @default(uuid())
  leaderboardId      String
  name               String
  registrationNumber String?
  
  leaderboard Leaderboard @relation(fields: [leaderboardId], references: [id], onDelete: Cascade)
}

model CoreTeamMember {
  id              String   @id @default(uuid())
  name            String
  position        String
  batch           String?
  domain          String?
  email           String?
  linkedinProfile String?
  photograph      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Team {
  id        String   @id @default(uuid())
  name      String
  eventId   String
  leaderId  String
  createdAt DateTime @default(now())

  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  leader  User  @relation(fields: [leaderId], references: [id])

  members TeamMember[]

  @@unique([eventId, leaderId]) // one team per leader per event
}

model TeamMember {
  id                 String   @id @default(uuid())
  teamId             String?
  name               String
  registrationNumber String?
  userId             String?   // optional (external participant)
  
  team Team? @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

enum Role {
  USER
  ADMIN
}

enum Status {
  UPCOMING
  ONGOING
  COMPLETED
}